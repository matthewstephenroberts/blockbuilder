{
  "name": "blockbuilder-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "BlockBuilder desktop app — Parametric Technic tile & brick designer",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "BLOCKBUILDER_DEV_SERVER_URL=http://localhost:5174 electron .",
    "dev:devtools": "BLOCKBUILDER_DEV_SERVER_URL=http://localhost:5174 BLOCKBUILDER_DEVTOOLS=1 electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.blockbuilder.app",
    "productName": "BlockBuilder",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "web-dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlockBuilder"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    }
  }
}
